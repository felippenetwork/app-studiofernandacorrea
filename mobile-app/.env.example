# Mobile App Environment Variables
# Copy to .env.local and fill in your values

# ─── API Configuration ────────────────────────────────────────────────────────
# Local development (Expo Go on same network — use your machine's LAN IP):
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api

# Production:
# EXPO_PUBLIC_API_URL=https://api.studiofernandacorrea.com.br/api

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# 'true'  = use local mock data (no backend needed) — default
# 'false' = use real backend API
EXPO_PUBLIC_USE_MOCK=true
