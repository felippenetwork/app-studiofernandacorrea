{
  "expo": {
    "name": "Studio Fernanda Correa",
    "slug": "studio-fernanda-correa",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F5F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studiofernandacorrea.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a câmera para foto de perfil.",
        "NSPhotoLibraryUsageDescription": "Usamos a galeria para foto de perfil.",
        "NSUserNotificationsUsageDescription": "Notificações para confirmações e lembretes de agendamentos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F5F2"
      },
      "package": "com.studiofernandacorrea.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A4A0",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Studio Fernanda Correa"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos a galeria para foto de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/REPLACE_WITH_YOUR_EAS_PROJECT_ID"
    }
  }
}
