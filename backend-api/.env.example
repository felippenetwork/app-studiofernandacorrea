# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Trinks API
TRINKS_API_URL=https://api.trinks.com
TRINKS_API_KEY=your-trinks-api-key-here
TRINKS_COMPANY_ID=your-company-id

# Mercado Pago
MP_ACCESS_TOKEN=your-mercado-pago-access-token
MP_PUBLIC_KEY=your-mercado-pago-public-key
MP_WEBHOOK_SECRET=your-webhook-secret

# CORS
ALLOWED_ORIGINS=http://localhost:19000,exp://localhost:19000
