# Server
PORT=3000
NODE_ENV=development

# JWT — usuários
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# JWT — admin (secret separado dos tokens de usuário)
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Trinks API ───────────────────────────────────────────────────────────────
# Base URL: https://api.trinks.com  (do not include /v1 — added per-request)
# API Key:  gerado em Minha Conta → Token de API Pessoal no painel Trinks
# Company:  ID do estabelecimento no Trinks (estabelecimentoId)
# Webhook:  segredo para verificar assinatura HMAC-SHA256 dos webhooks SNS
TRINKS_API_URL=https://api.trinks.com
TRINKS_API_KEY=your-trinks-api-key-here
TRINKS_COMPANY_ID=your-trinks-estabelecimento-id
TRINKS_WEBHOOK_SECRET=your-trinks-webhook-secret

# ─── Getnet ───────────────────────────────────────────────────────────────────
# Portal: https://developers.getnet.com.br → Minha Conta → Credenciais
# GETNET_ENV: 'sandbox' para testes, 'production' para produção
GETNET_CLIENT_ID=your-getnet-client-id
GETNET_CLIENT_SECRET=your-getnet-client-secret
GETNET_SELLER_ID=your-getnet-seller-id
GETNET_ENV=sandbox

# Backend public URL (required for Getnet webhook and email verification links)
# In production: https://api.seudominio.com
# Configure o webhook no portal Getnet apontando para: https://api.seudominio.com/api/payments/webhook
API_BASE_URL=https://api.yourdomain.com

# ─── E-mail / SMTP ───────────────────────────────────────────────────────────
# Sem SMTP: cadastro funciona sem verificação (bom para dev)
# Com SMTP: exige confirmação de e-mail antes do primeiro login
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-app-password
SMTP_FROM=Studio Fernanda Correa <noreply@studiofernandacorrea.com.br>

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:19000,exp://localhost:19000,https://yourdomain.com
